# Copy this file to .env.local and fill in the value.
# .env.local is gitignored — never commit real values.
#
# Your deployed Google Apps Script Web App /exec URL.
# Get it from: script.google.com → Deploy → Manage deployments → Web app URL.
# Leave the placeholder and the frontend falls back to CONFIG.gifts for local
# gift-list preview without hitting the backend.
VITE_APPSCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Optional: the PayPal REST app's Client ID (developer.paypal.com → Apps &
# Credentials). Sandbox ID for local testing, Live ID in the GitHub secret.
# It is public; the Secret goes only in the Apps Script's Script Properties.
# Empty → the PayPal option is hidden and guests see PIX only.
VITE_PAYPAL_CLIENT_ID=

# Optional, for `npm run backend:deploy`: the Web App deployment to republish.
# Defaults to the one in VITE_APPSCRIPT_URL (the AKfycb… part), so the site
# keeps calling the same /exec URL.
# APPSCRIPT_DEPLOYMENT_ID=
