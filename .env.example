# Copy this file to .env.local and fill in the value.
# .env.local is gitignored — never commit real values.
#
# Your deployed Google Apps Script Web App /exec URL.
# Get it from: script.google.com → Deploy → Manage deployments → Web app URL.
# Leave the placeholder and the frontend falls back to CONFIG.gifts for local
# gift-list preview without hitting the backend.
VITE_APPSCRIPT_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# The PIX key (CPF, phone +55…, email or random key). Kept out of the repo,
# which is public; the same name as a GitHub Actions secret for the live site.
VITE_PIX_KEY=

# Optional: paying in euros (guests abroad, who read the site in English).
# Kept out of the repo, which is public; the same names as GitHub Actions
# secrets for the live site. The PayPal.Me username (paypal.me/<this>) and the
# Revolut.Me username (revolut.me/<this>). An empty one hides its way.
VITE_PAYPAL_ME=
VITE_REVOLUT_ME=

# Optional, for `npm run photos:sync` (copies guest photos from Drive into
# public/guest-photos/ for local dev). Same value as the PHOTO_SYNC_TOKEN
# Script Property and GitHub secret.
PHOTO_SYNC_TOKEN=

# Optional, for `npm run backend:deploy`: the Web App deployment to republish.
# Defaults to the one in VITE_APPSCRIPT_URL (the AKfycb… part), so the site
# keeps calling the same /exec URL.
# APPSCRIPT_DEPLOYMENT_ID=
